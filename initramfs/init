#!/bin/sh
# Mi MIX 2 Debian initramfs: mount the root filesystem from the userdata
# partition and switch to it. If that fails (or "mix2.rescue" is on the
# kernel command line) start a rescue shell reachable over USB networking:
#   telnet 172.16.42.1     (raw shell: nc 172.16.42.1 5555)

/bin/busybox --install -s /bin
export PATH=/bin

mkdir -p /proc /sys /dev /tmp /run /newroot
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

log() { echo "[mix2-initramfs] $*" > /dev/kmsg; }

ROOT_PARTNAME=userdata
for arg in $(cat /proc/cmdline); do
	case "$arg" in
		mix2.root=*) ROOT_PARTNAME=${arg#mix2.root=} ;;
		mix2.rescue) RESCUE=1 ;;
		mix2.crashdump) CRASHDUMP=1 ;;
	esac
done

# Bring-up aid: with "mix2.crashdump panic=5" a boot that cannot reach the
# USB rescue shell logs why devices are stuck and panics, so the phone
# reboots on its own and the log can be read from pstore (ramoops).
crashdump() {
	log "crashdump: $*"
	mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
	for f in /sys/kernel/debug/devices_deferred; do
		while read -r l; do log "deferred: $l"; done < "$f"
	done
	log "udc: $(ls /sys/class/udc 2>/dev/null) block: $(ls /sys/class/block 2>/dev/null | tr '\n' ' ')"
	echo w > /proc/sysrq-trigger
	sleep 1
	echo c > /proc/sysrq-trigger
}

find_partition() {
	for u in /sys/class/block/*/uevent; do
		if grep -qx "PARTNAME=$1" "$u"; then
			echo "/dev/$(sed -n 's/^DEVNAME=//p' "$u")"
			return 0
		fi
	done
	return 1
}

rescue() {
	log "entering USB rescue mode: $*"
	echo "MIX 2 rescue mode: $*" > /dev/tty0
	echo "telnet 172.16.42.1 from the PC (USB cable)" > /dev/tty0
	mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
	mount -t configfs configfs /sys/kernel/config
	mount -t pstore pstore /sys/fs/pstore 2>/dev/null
	G=/sys/kernel/config/usb_gadget/rescue
	mkdir -p $G/strings/0x409 $G/functions/ncm.usb0 $G/configs/c.1/strings/0x409
	echo 0x1d6b > $G/idVendor
	echo 0x0104 > $G/idProduct
	echo "Xiaomi" > $G/strings/0x409/manufacturer
	echo "Mi MIX 2 rescue" > $G/strings/0x409/product
	echo "chiron-rescue" > $G/strings/0x409/serialnumber
	echo "NCM" > $G/configs/c.1/strings/0x409/configuration
	ln -s $G/functions/ncm.usb0 $G/configs/c.1/
	for i in $(seq 1 50); do [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && break; sleep 0.2; done
	[ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ -n "$CRASHDUMP" ] && crashdump "no USB device controller ($*)"
	ls /sys/class/udc | head -1 > $G/UDC
	sleep 1
	ifconfig lo 127.0.0.1 up
	ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up
	printf 'start 172.16.42.2\nend 172.16.42.2\ninterface usb0\nmax_leases 1\noption subnet 255.255.255.0\nlease_file /tmp/leases\n' > /tmp/udhcpd.conf
	touch /tmp/leases
	udhcpd /tmp/udhcpd.conf
	telnetd -l /bin/sh -p 23
	( while true; do nc -l -p 5555 -e /bin/sh; done ) &
	while true; do sleep 3600; done
}

[ -n "$RESCUE" ] && rescue "requested on the kernel command line"

DEV=""
for i in $(seq 1 100); do
	DEV=$(find_partition "$ROOT_PARTNAME") && [ -b "$DEV" ] && break
	sleep 0.1
done
[ -b "$DEV" ] || rescue "partition $ROOT_PARTNAME not found"

log "mounting $DEV ($ROOT_PARTNAME) as root"
mount -t ext4 -o rw,noatime "$DEV" /newroot || rescue "cannot mount $DEV"
[ -x /newroot/sbin/init ] || { umount /newroot; rescue "no /sbin/init on $DEV"; }

umount /proc /sys
mount --move /dev /newroot/dev 2>/dev/null || umount /dev
exec switch_root /newroot /sbin/init
mount -t proc proc /proc; mount -t sysfs sysfs /sys
rescue "switch_root failed"
