# Xiaomi Mi MIX 2 (chiron) additions on top of arm64 defconfig.
# Everything needed to reach a root filesystem and a usable console is built in.
CONFIG_LOCALVERSION="-chiron"
# CONFIG_LOCALVERSION_AUTO is not set

# SoC core: clocks, power domains, RPM, PMIC
CONFIG_ARCH_QCOM=y
CONFIG_MSM_GCC_8998=y
CONFIG_MSM_MMCC_8998=y
CONFIG_MSM_GPUCC_8998=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_MAILBOX=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_MSM8998=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
CONFIG_QCOM_CPR=y
CONFIG_QCOM_SPM=y

# Storage
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_F2FS_FS=y

# Display: bootloader framebuffer via simpledrm, kernel console on it
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FB_SIMPLE is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Input: touchscreen, buttons, hall sensor
CONFIG_I2C_QUP=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F55=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_EVDEV=y

# USB: device mode networking for bring-up, host mode for keyboards/hubs
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_HID=y
CONFIG_USB_STORAGE=y

# Crash logs that survive a reboot into the bootloader/recovery
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Remote processors, Wi-Fi, Bluetooth
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m
CONFIG_QCOM_RMTFS_MEM=m
CONFIG_QCOM_PDR_HELPERS=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_TUN=m
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# Power supply, ADC, backlight, LEDs, haptics
CONFIG_QCOM_SPMI_RRADC=m
CONFIG_QCOM_SPMI_ADC5=m
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_BACKLIGHT_QCOM_WLED=m
CONFIG_LEDS_QCOM_LPG=m

# Desktop userspace expectations
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_AUTOFS_FS=y
CONFIG_FANOTIFY=y
CONFIG_SECCOMP=y
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Size: the bootloader places the ramdisk/DT at fixed offsets, so keep the
# uncompressed kernel small by dropping every non-Qualcomm platform and
# server/virtualisation features a phone does not need.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# CONFIG_ACPI is not set
# CONFIG_PCI is not set
# CONFIG_KVM is not set
# CONFIG_XEN is not set
# CONFIG_NUMA is not set
# CONFIG_EFI is not set
# CONFIG_HYPERV is not set
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Power key, volume down (RESIN) and "reboot bootloader/recovery"
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_NVMEM_SPMI_SDAM=y

# ath10k debug output (debug_mask module parameter) for Wi-Fi bring-up
CONFIG_ATH10K_DEBUG=y
CONFIG_ATH10K_DEBUGFS=y

# Battery fuel gauge (porthole qcom_fg) and PMI8998 charger
CONFIG_BATTERY_QCOM_FG=m
CONFIG_CHARGER_QCOM_SMB2=m

# USB host mode: OTG 5 V output and its userspace switch
CONFIG_REGULATOR_QCOM_USB_VBUS=y
CONFIG_REGULATOR_USERSPACE_CONSUMER=y

# Display (DPU + DSI + JDI NT35596S panel) and Adreno 540
CONFIG_REGULATOR_QCOM_LABIBB=y
CONFIG_DRM_PANEL_JDI_NT35596S=m
CONFIG_DRM_MSM=m

# Lockup / hung task detectors (panic only with *_panic=1 on the cmdline)
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# Audio: QDSP6 APR, SLIMbus NGD, WCD9335 and MSM8998 machine, built in as
# on the tested audio kernels. The TAS2559 speaker amplifier is the external
# module in kernel/tas2559/.
# Use pd-mapper with this phone's adspua.jsn; the in-kernel MSM8998
# service map lacks audio_pd and competes with the userspace locator.
# CONFIG_QCOM_PD_MAPPER is not set
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_SOC=y
CONFIG_QCOM_APR=y
CONFIG_SLIMBUS=y
CONFIG_SLIM_QCOM_NGD_CTRL=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_MSM8998=y
CONFIG_SND_SOC_WCD9335=y
CONFIG_SND_SOC_WCD_COMMON=y
CONFIG_SND_SOC_WCD_CLASSH=y
CONFIG_SND_SOC_WCD_MBHC=y
# USB-C headphones / USB DACs (through a hub in host mode)
CONFIG_SND_USB_AUDIO=m
# Virtual input devices: mix2-touch-longpress (long press = right click)
CONFIG_INPUT_UINPUT=m
