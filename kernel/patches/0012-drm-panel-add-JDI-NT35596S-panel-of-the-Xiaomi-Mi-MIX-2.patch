+static int jdi_nt35596s_prepare(struct drm_panel *panel)
+{
+	struct jdi_nt35596s *ctx = to_jdi_nt35596s(panel);
+	struct device *dev = &ctx->dsi->dev;
+	unsigned int attempt;
+	char log[256];
+	int ret, bad;
+
+	/*
+	 * The rails stay up once enabled, like on the stock kernel where the
+	 * touch driver holds the display supplies; every later power up only
+	 * resets and initialises the panel again.
+	 */
+	if (!ctx->powered) {
+		ret = regulator_bulk_enable(ARRAY_SIZE(jdi_nt35596s_supplies),
+					    ctx->supplies);
+		if (ret < 0) {
+			dev_err(dev, "Failed to enable regulators: %d\n", ret);
+			return ret;
+		}
+		ctx->powered = true;
+
+		/*
+		 * The bootloader brought the panel up (and the in-cell touch
+		 * controller synced to it): keep that state.
+		 */
+		if (ctx->handover) {
+			ctx->handover = false;
+			return 0;
+		}
+	}
+
+	for (attempt = 1; ; attempt++) {
+		jdi_nt35596s_reset(ctx);
+
+		ret = long_init ? jdi_nt35596s_on_long(ctx) : jdi_nt35596s_on_short(ctx);
+		if (ret < 0) {
+			dev_err(dev, "Failed to initialize panel: %d\n", ret);
+			gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+			return ret;
+		}
+
+		if (!verify)
+			break;
+
+		bad = jdi_nt35596s_check(ctx, log, sizeof(log));
+		if (bad < 0) {
+			dev_warn(dev, "Cannot read back the panel state: %d\n", bad);
+			break;
+		}
+		if (!bad) {
+			if (verbose || attempt > 1)
+				dev_info(dev, "panel up (attempt %u, reset delay %u ms): %s\n",
+					 attempt, reset_delay_ms, log);
+			break;
+		}
+		dev_warn(dev, "panel came up wrong (attempt %u, reset delay %u ms): %s\n",
+			 attempt, reset_delay_ms, log);
+		if (attempt > max_retries)
+			break;
+	}
+
+	return 0;
+}
