+/*
+ * Check that the panel is awake and displaying and, after the long sequence,
+ * that its colour pages hold what was written. Returns the number of wrong
+ * registers, or a negative error when they cannot be read.
+ */
+static int jdi_nt35596s_check(struct jdi_nt35596s *ctx, char *log, size_t len)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	u8 page = 0x10, sel[2], val;
+	size_t n;
+	int i, ret, bad = 0;
+
+	ret = jdi_nt35596s_read(ctx, MIPI_DCS_GET_POWER_MODE, &val);
+	if (ret)
+		return ret;
+	/* Booster on, sleep out, normal mode, display on */
+	if (val != 0x9c)
+		bad++;
+	n = scnprintf(log, len, "power mode %02x%s", val, val != 0x9c ? "!" : "");
+
+	if (!long_init)
+		return bad;
+
+	for (i = 0; i < ARRAY_SIZE(jdi_nt35596s_checks); i++) {
+		if (jdi_nt35596s_checks[i].page != page) {
+			page = jdi_nt35596s_checks[i].page;
+			sel[0] = 0xff;
+			sel[1] = page;
+			mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, sel, 2);
+			mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfb, 0x01);
+			if (dsi_ctx.accum_err) {
+				ret = dsi_ctx.accum_err;
+				break;
+			}
+		}
+		ret = jdi_nt35596s_read(ctx, jdi_nt35596s_checks[i].reg, &val);
+		if (ret)
+			break;
+		if (val != jdi_nt35596s_checks[i].val)
+			bad++;
+		n += scnprintf(log + n, len - n, " %02x:%02x=%02x%s", page,
+			       jdi_nt35596s_checks[i].reg, val,
+			       val != jdi_nt35596s_checks[i].val ? "!" : "");
+	}
+
+	/* Back to the user command set */
+	dsi_ctx.accum_err = 0;
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x10);
+	if (!ret)
+		ret = dsi_ctx.accum_err;
+
+	return ret ? ret : bad;
+}
