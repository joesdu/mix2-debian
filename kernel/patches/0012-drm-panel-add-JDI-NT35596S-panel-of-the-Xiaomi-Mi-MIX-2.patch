+/*
+ * The panel is never put to sleep (see below), so every reset hits it in
+ * sleep out mode. Like other DCS driver ICs it then needs up to 120 ms to
+ * blank and reload its defaults before it takes commands; with the 10 ms of
+ * the stock reset sequence (which Android applies after sleep in) parts of
+ * the init sequence got lost now and then: washed out, grey looking colours
+ * and soft text, or a panel that stayed dark.
+ */
+static unsigned int reset_delay_ms = 150;
+module_param(reset_delay_ms, uint, 0644);
+MODULE_PARM_DESC(reset_delay_ms, "Wait after releasing the panel reset before initialising it (ms)");
+
+static bool verify = true;
+module_param(verify, bool, 0644);
+MODULE_PARM_DESC(verify, "Read back the panel state after initialising it, and initialise it again when it is wrong");
+
+static unsigned int max_retries = 2;
+module_param(max_retries, uint, 0644);
+MODULE_PARM_DESC(max_retries, "How often to initialise the panel again when the read back state is wrong");
+
+static bool verbose;
+module_param(verbose, bool, 0644);
+MODULE_PARM_DESC(verbose, "Log the read back panel state after every initialisation");
