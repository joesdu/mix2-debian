+MODULE_PARM_DESC(handover, "Keep the panel as initialised by the bootloader on the first power up");
+
+static bool long_init = true;
+module_param(long_init, bool, 0644);
+MODULE_PARM_DESC(long_init, "Use the stock kernel DT init sequence instead of the XBL one");
