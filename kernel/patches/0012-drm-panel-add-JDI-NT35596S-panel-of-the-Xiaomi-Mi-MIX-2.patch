+/*
+ * No unprepare: the supplies stay on and the panel is reset and initialised
+ * again on the next prepare.
+ *
+ * Without disable the panel stays awake and its video stream is just cut
+ * off. It then came up with snow and stripes after every other reset (the
+ * SoC side registers identical either way), screen rotation included. The
+ * stock kernel sends display off and sleep in (high speed, while the video
+ * still runs) before it resets the panel; so does this driver: 14 of 14
+ * screen on cycles and rotations came up clean, against every other one
+ * without. An earlier attempt at sleep in had left a panel that never
+ * answered again, found while the reset delay was still the 10 ms that is
+ * too short.
+ */
+static bool sleep_on_disable = true;
+module_param(sleep_on_disable, bool, 0644);
+MODULE_PARM_DESC(sleep_on_disable, "Send display off and sleep in when the panel is disabled, like the stock kernel");
+
+static int jdi_nt35596s_disable(struct drm_panel *panel)
+{
+	struct jdi_nt35596s *ctx = to_jdi_nt35596s(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	if (!sleep_on_disable)
+		return 0;
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 70);
+	if (dsi_ctx.accum_err)
+		dev_warn(&ctx->dsi->dev, "Failed to put the panel to sleep: %d\n",
+			 dsi_ctx.accum_err);
+	else if (verbose)
+		dev_info(&ctx->dsi->dev, "panel asleep\n");
+
+	return 0;
+}
