+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *reset_gpio;
+	bool handover;
+	bool powered;
+};
+
+static const struct regulator_bulk_data jdi_nt35596s_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "vsp" },
+	{ .supply = "vsn" },
+};
+
+static inline struct jdi_nt35596s *to_jdi_nt35596s(struct drm_panel *panel)
+{
+	return container_of_const(panel, struct jdi_nt35596s, panel);
+}
+
+static void jdi_nt35596s_reset(struct jdi_nt35596s *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(max(reset_delay_ms, 10U));
+}
