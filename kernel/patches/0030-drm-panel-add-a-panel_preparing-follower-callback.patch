From: mix2-port <mix2@localhost>
Subject: [PATCH] drm/panel: add a panel_preparing follower callback

The Synaptics S3330 touch controller of the Xiaomi Mi MIX 2 sits in an
in-cell JDI panel, and the stock driver pulses its reset right before the
panel is powered up and initialised. Let followers act at that point, so
that rmi4-i2c can do the same (its panel_follow_mode=2, not the default).
---
--- a/drivers/gpu/drm/drm_panel.c
+++ b/drivers/gpu/drm/drm_panel.c
@@ -126,6 +126,16 @@
 
 	mutex_lock(&panel->follower_lock);
 
+	list_for_each_entry(follower, &panel->followers, list) {
+		if (!follower->funcs->panel_preparing)
+			continue;
+
+		ret = follower->funcs->panel_preparing(follower);
+		if (ret < 0)
+			dev_info(panel->dev, "%ps failed: %d\n",
+				 follower->funcs->panel_preparing, ret);
+	}
+
 	if (panel->funcs && panel->funcs->prepare) {
 		ret = panel->funcs->prepare(panel);
 		if (ret < 0)
--- a/include/drm/drm_panel.h
+++ b/include/drm/drm_panel.h
@@ -174,6 +174,15 @@
 	 * Called before the panel and the backlight are disabled.
 	 */
 	int (*panel_disabling)(struct drm_panel_follower *follower);
+
+	/**
+	 * @panel_preparing:
+	 *
+	 * Called before the panel is powered on and initialised, e.g. for the
+	 * touch controller of an in-cell panel that has to start up together
+	 * with the panel.
+	 */
+	int (*panel_preparing)(struct drm_panel_follower *follower);
 };
 
 struct drm_panel_follower {
