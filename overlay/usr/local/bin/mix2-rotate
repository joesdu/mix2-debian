#!/bin/sh
# Rotate the screen and the touchscreen together.
# usage: mix2-rotate normal|left|right|inverted|toggle|restore
#   toggle   switch between portrait (normal) and landscape (right)
#   restore  re-apply the last orientation (run at login)
# The chosen orientation is remembered in ~/.config/mix2-rotation.

STATE=${XDG_CONFIG_HOME:-$HOME/.config}/mix2-rotation

output=$(xrandr --query | awk '/ connected/ {print $1; exit}')
[ -n "$output" ] || { echo "no connected output" >&2; exit 1; }

current() {
	xrandr --query | awk -v o="$output" '$1 == o {
		for (i = 3; i <= NF; i++) {
			if ($i ~ /^\(/) break
			if ($i ~ /^(left|right|inverted)$/) { print $i; exit }
		}
		print "normal"; exit
	}'
}

case "$1" in
	normal|left|right|inverted) want=$1 ;;
	toggle) [ "$(current)" = normal ] && want=right || want=normal ;;
	restore) want=$(cat "$STATE" 2>/dev/null); [ -n "$want" ] || exit 0 ;;
	*) echo "usage: $0 normal|left|right|inverted|toggle|restore" >&2; exit 1 ;;
esac

xrandr --output "$output" --rotate "$want" || exit 1

# Map every touchscreen onto the (now rotated) output
for id in $(xinput list --id-only 2>/dev/null); do
	xinput list-props "$id" 2>/dev/null | grep -q "Coordinate Transformation Matrix" || continue
	if xinput list --long "$id" 2>/dev/null | grep -q "Touch mode: direct"; then
		xinput map-to-output "$id" "$output"
	fi
done

mkdir -p "$(dirname "$STATE")"
echo "$want" > "$STATE"
